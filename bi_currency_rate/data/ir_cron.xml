<odoo>
    <data noupdate="1">
        <record id="ir_cron_fetch_bi_rates" model="ir.cron">
            <field name="name">Fetch Bank Indonesia Currency Rates</field>
            <field name="model_id" ref="base.model_res_currency_rate"/>
            <field name="state">code</field>
            <field name="code">model.fetch_bi_rates()</field>
            <field name="active">True</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall">False</field>
            <field name="nextcall" eval="(datetime.now().replace(hour=4, minute=30, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
