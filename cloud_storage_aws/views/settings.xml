<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="cloud_storage_aws_config_settings_view_form" model="ir.ui.view">
        <field name="name">cloud_storage_aws_config_settings_view_form</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70"/>
        <field name="inherit_id" ref="cloud_storage.cloud_storage_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='cloud_storage_provider']" position="inside">
                <div class="content-group mt16" invisible="cloud_storage_provider != 'aws'">
                    <label for="cloud_storage_aws_bucket_name" class="o_light_label mr8"/>
                    <field name="cloud_storage_aws_bucket_name" required="cloud_storage_provider == 'aws'"/>
                    <br/>
                    <label for="cloud_storage_aws_region" class="o_light_label mr8"/>
                    <field name="cloud_storage_aws_region" placeholder="ap-southeast-3" required="cloud_storage_provider == 'aws'"/>
                    <br/>
                    <label for="cloud_storage_aws_access_key_id" class="o_light_label mr8"/>
                    <field name="cloud_storage_aws_access_key_id" required="cloud_storage_provider == 'aws'"/>
                    <br/>
                    <label for="cloud_storage_aws_secret_access_key" class="o_light_label mr8"/>
                    <field name="cloud_storage_aws_secret_access_key" password="True" required="cloud_storage_provider == 'aws'"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
